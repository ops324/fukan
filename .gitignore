node_modules/
.env
*.log
.DS_Store

# ビルド成果物。Vercel が buildCommand:"npm run build" でデプロイ時に生成・配信する。
# render 系スクリプト（ingest/backfill/set-press/renderOnly/build）の出力先はすべて dist。
# 生成物を VCS に置かないことで Git 肥大（毎ジョブの数百ファイル churn）を断つ。
dist/

# 旧モデル（生成物を root にコミットして配信）で追跡されていた生成物。
# Vercel ビルド化に伴い VCS から外す（git rm --cached 済み・以後 untracked）。
/index.html
/about.html
/contact.html
/privacy.html
/terms.html
/editorial.html
/disclaimer.html
/archive.html
/feed.xml
/feed.xsl
/robots.txt
/sitemap.xml
/search-index.json
/articles/
/sections/
/tags/
/archive/

# 実行時の一時ファイル（articles.json は正本なのでコミットする）
# 原子的書き込み（src/atomicWrite.js）の一時ファイル。SIGKILL や電源断では掃除できないため、
# 残骸が auto-generate.sh の `git add -A` で本番へ push されるのを .gitignore で確実に防ぐ。
# 一度追跡されると git status が常に汚れ、毎ランで空コミットと無意味な再デプロイが積まれる。
data/*.tmp
data/quality/*.tmp

data/_candidates.json
data/_drafts.json
data/_review.json
# 下書きリントの結果（writer の検算／auto-generate.sh の件数取得に使う一時ファイル）
data/_lint.json
# Phase 4 画像一致 LLM 査読の一時ファイル（ingest→査読→applyImageReview が消費。VCS に残さない）
data/_image_review_targets.json
data/_image_review.json
# 修正リトライの一時ファイル（prepareFixRound→fix-writer→再査読→mergeFixReview が消費）
data/_drafts.bak.json
data/_fix_targets.json
data/_fix_result.json
data/_review_fixed.json
data/_writer.log
data/scheduler.log
data/.health
# 自動ジョブの状態（最終成功・直近エラー・連続失敗回数）。人間が一目で見るためのローカル状態。
# 追跡すると毎ラン差分が出て「コミットは実質 articles.json のみ」の配信モデルを壊す。
data/.status
# 評価 ledger の退避アーカイブ（有界化で溢れた古い行。履歴はローカル保持・git には載せない）
data/quality/*.archive.jsonl
data/.harness.lock/

# Claude Code ローカル状態
.claude/scheduled_tasks.lock

# デザインスプリントの試作物（隔離・本番配信させない／自動ジョブに拾わせない）
design-sprint/

# 公式プレス画像のローカル複製（assets/press/）は配信物なので「コミットする」。無視しない。
